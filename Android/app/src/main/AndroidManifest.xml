<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application android:allowBackup="false" android:debuggable="false"
        android:label="PAM Fingerprint" android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:supportsRtl="true" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".DisplaySettingsActivity" android:exported="false" />
        <activity android:name=".DisplayPreviewActivity" android:exported="false"
            android:configChanges="orientation|screenSize"
            android:excludeFromRecents="true" />
        <activity android:name=".AuthActivity" android:exported="true"
            android:configChanges="orientation|screenSize"
            android:excludeFromRecents="true" />
        <provider android:name=".ResultProvider"
            android:authorities="com.randiny_games.fingerprintauthenticator.results"
            android:exported="true" android:grantUriPermissions="false" />
    </application>
</manifest>
